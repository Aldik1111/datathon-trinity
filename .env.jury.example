# Reference only: use an environment variable for the real secret.
# This example does not contain a working API key and is not loaded automatically.
API_KEY=
ANALYZER_MODE=real
DEFAULT_ANALYSIS_TYPE=jury
JURY_ANALYZER=bank_scenarios
SCENARIO_MODEL_PATH=artifacts/handoff-baseline/scenario-model
# Retained only for explicitly requested safe_state; its ROI remains required.
ANALYZER_CALLABLE=src.vision.safe_classifier:analyze_video
MODEL_PATH=artifacts/handoff-baseline/safe-model
RULES_PATH=configs/rules.json
UPLOAD_DIR=artifacts/jury-api/uploads
API_DB_PATH=artifacts/jury-api/jobs.sqlite3
MAX_UPLOAD_MB=100
ANALYZER_TIMEOUT_SEC=295
MAX_PENDING_JOBS=2
JOB_TTL_SEC=86400
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
