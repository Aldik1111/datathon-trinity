# Generate your own key. Blank key prevents API startup.
API_KEY=
API_URL=http://127.0.0.1:8000
UPLOAD_DIR=artifacts/uploads
MAX_UPLOAD_MB=100
# Development only. Change to real after participant 2 supplies the local model.
ANALYZER_MODE=demo
ANALYZER_CALLABLE=src.vision.analyzer:analyze_video
MODEL_PATH=weights/model
RULES_PATH=configs/rules.json
ANALYZER_TIMEOUT_SEC=300
MAX_PENDING_JOBS=2
JOB_TTL_SEC=86400
# Optional SQLite location for local runs (defaults to UPLOAD_DIR/jobs.sqlite3).
API_DB_PATH=
# Public deployment only after host/domain/access approval. Leave blank locally.
PUBLIC_DOMAIN=
JURY_USER=
# Store bcrypt hash in single quotes to preserve dollar signs; never a plaintext password.
JURY_PASSWORD_HASH=
