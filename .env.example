# Generate your own key. Blank key prevents API startup.
API_KEY=
API_URL=http://127.0.0.1:8000
UPLOAD_DIR=artifacts/uploads
API_DB_PATH=artifacts/jobs.sqlite3
MAX_UPLOAD_MB=100
# Development only. Change to real after participant 2 supplies the local model.
ANALYZER_MODE=demo
ANALYZER_CALLABLE=src.vision.analyzer:analyze_video
MODEL_PATH=weights/model
RULES_PATH=configs/rules.json
ANALYZER_TIMEOUT_SEC=300
MAX_PENDING_JOBS=2
JOB_TTL_SEC=86400
# Only for an explicitly approved public deployment (leave blank locally).
DOMAIN=
JURY_USER=
# Put a bcrypt hash in single quotes in .env so dollar signs stay literal.
JURY_PASSWORD_HASH=
