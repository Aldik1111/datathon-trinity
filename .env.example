# Generate your own key. Blank key prevents API startup.
API_KEY=
API_URL=http://127.0.0.1:8000
UPLOAD_DIR=artifacts/uploads
MAX_UPLOAD_MB=100
# Development only. Change to real after participant 2 supplies the local model.
ANALYZER_MODE=demo
DEFAULT_ANALYSIS_TYPE=jury
# For real jury submissions use the separate profile documented in docs/JURY_API.md.
# Leave blank for this explicit development/demo configuration.
JURY_ANALYZER=
ANALYZER_CALLABLE=src.vision.analyzer:analyze_video
MODEL_PATH=weights/model
# Optional experimental 18-scenario model and local UI comparison/example paths.
SCENARIO_MODEL_PATH=
SCENARIO_DATASET_MANIFEST=
SCENARIO_COMPARISON_REPORT=
RULES_PATH=configs/rules.json
ANALYZER_TIMEOUT_SEC=300
MAX_PENDING_JOBS=2
JOB_TTL_SEC=86400
